{
  "entities": {
    "User": {
      "title": "User",
      "description": "User accounts including superadmin, teacher, admin, and student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["superadmin", "admin", "teacher", "student"] },
        "grade": { "type": "string", "maxLength": 64 },
        "school": { "type": "string", "maxLength": 128 },
        "points": { "type": "number" },
        "level": { "type": "number" },
        "currentXp": { "type": "number" },
        "streakDays": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "nisn": { "type": "string", "maxLength": 32 },
        "nip": { "type": "string", "maxLength": 32 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "username", "name", "role"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Student mission progress, scores, badges, and completed sections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "missionId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["locked", "in_progress", "completed"] },
        "score": { "type": "number" },
        "badgeAwarded": { "type": "boolean" },
        "completedSections": { "type": "array" }
      },
      "required": ["studentId", "missionId"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Global school configuration and identity",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 128 },
        "npsn": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "principalName": { "type": "string", "maxLength": 128 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["schoolName"]
    },
    "School": {
      "title": "School",
      "description": "School directory record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "npsn": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name"]
    },
    "Class": {
      "title": "Class",
      "description": "School class grouping",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "grade": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "name"]
    },
    "FinalMissionProgress": {
      "title": "FinalMissionProgress",
      "description": "Student progress in the Final Mission 3-stage challenge",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "classification": { "type": "string", "maxLength": 64 },
        "stage1Completed": { "type": "boolean" },
        "stage2Completed": { "type": "boolean" },
        "stage3Completed": { "type": "boolean" },
        "stage1Score": { "type": "number" },
        "stage2Score": { "type": "number" },
        "stage3Score": { "type": "number" },
        "grandTitleAwarded": { "type": "boolean" },
        "completedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "classification"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "/student_progress/{progressId}": {
      "schema": "StudentProgress",
      "description": "Student mission progress records"
    },
    "/settings/{settingId}": {
      "schema": "SchoolSettings",
      "description": "School settings and metadata"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Registered schools"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Registered classes"
    },
    "/final_mission_progress/{fmpId}": {
      "schema": "FinalMissionProgress",
      "description": "Final mission evaluation records"
    }
  }
}
